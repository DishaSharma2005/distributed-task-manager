# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Port the application listens on inside the container
PORT=3000

# MongoDB connection string
# For local Docker Compose: mongodb://mongo:27017/taskmanager
# For MongoDB Atlas:        mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskmanager
MONGODB_URI=your_mongodb_connection_string

# Identifies which server instance is running.
# Set to EC2-INSTANCE-1 on your first EC2 instance,
# and EC2-INSTANCE-2 on your second EC2 instance.
# For local development use: LOCAL
INSTANCE_ID=LOCAL
